@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    var configuredClientSlug = Configuration["Tenant:ClientSlug"] ?? "";
    var clientSlug = (ViewContext.RouteData.Values["client"]?.ToString() ?? configuredClientSlug).Trim();
    var pageTitle = ViewData["Title"] as string ?? "My Workspace";
    var employeeName = User.Identity?.Name ?? "Employee";
    var initials = string.Join("", employeeName.Split(new[] { '@', '.', ' ', '_' }, StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(part => char.ToUpperInvariant(part[0])));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f7fb" />
    <title>@pageTitle - WebStaffSync</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-body">
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index" asp-route-client="@clientSlug" aria-label="WebStaffSync home">
                <span class="brand-symbol"><span></span><span></span><span></span><span></span></span>
                <span class="brand-word">Staff<span>Sync</span></span>
                <span class="brand-edition">ESS</span>
            </a>

            <div class="sidebar-employee">
                <div class="avatar avatar-sidebar">@initials</div>
                <div class="sidebar-employee-copy">
                    <strong>@employeeName</strong>
                    <span>Employee workspace</span>
                </div>
                <span class="online-indicator" title="Signed in"></span>
            </div>

            <nav class="sidebar-nav" aria-label="Main navigation">
                <div class="nav-caption">MY WORKSPACE</div>
                <a class="sidebar-link active" asp-controller="Home" asp-action="Index" asp-route-client="@clientSlug">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.6"></rect><rect x="14" y="3" width="7" height="5" rx="1.6"></rect><rect x="14" y="11" width="7" height="10" rx="1.6"></rect><rect x="3" y="14" width="8" height="7" rx="1.6"></rect></svg>
                    <span>Dashboard</span>
                </a>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MyProfile" ? "active" : "")"
                   asp-controller="MyProfile" asp-action="Index" asp-route-client="@clientSlug">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"></circle><path d="M4.8 20c.7-3.5 3.1-5.3 7.2-5.3s6.5 1.8 7.2 5.3"></path></svg>
                    <span>My Profile</span>
                </a>
                <span class="sidebar-link is-disabled" title="Attendance module will be enabled in a subsequent release">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2"></rect><path d="M7.5 3v4M16.5 3v4M3.5 9.5h17M8 13h2m4 0h2M8 16.5h2"></path></svg>
                    <span>My Attendance</span><small>Later</small>
                </span>
                <span class="sidebar-link is-disabled" title="Leave module will be enabled in a subsequent release">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h10M8 3.5v4l-3.5 6a5.5 5.5 0 0 0 4.8 8h5.4a5.5 5.5 0 0 0 4.8-8L16 7.5v-4"></path><path d="M7 15h10"></path></svg>
                    <span>My Leaves</span><small>Later</small>
                </span>

                <div class="nav-caption nav-caption-spaced">PAY &amp; BENEFITS</div>
                <span class="sidebar-link is-disabled" title="Payslips module will be enabled in a subsequent release">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"></rect><path d="M8 8h8M8 12h8M8 16h4"></path></svg>
                    <span>My Payslips</span><small>Later</small>
                </span>
                <span class="sidebar-link is-disabled" title="Advances module will be enabled in a subsequent release">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M15.5 8.5c-.7-.8-1.8-1.2-3.2-1.2-1.8 0-3 .9-3 2.2 0 3.5 6.5 1.1 6.5 4.8 0 1.4-1.3 2.4-3.3 2.4-1.5 0-2.8-.5-3.7-1.5M12 5.5v13"></path></svg>
                    <span>My Advances</span><small>Later</small>
                </span>
                <span class="sidebar-link is-disabled" title="Reimbursements module will be enabled in a subsequent release">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5h16v12H4zM4 10h16M8 15h3"></path><path d="M7 7.5V4.5h10v3"></path></svg>
                    <span>Reimbursements</span><small>Later</small>
                </span>

                <div class="nav-caption nav-caption-spaced">MY RESOURCES</div>
                <span class="sidebar-link is-disabled" title="Assets module will be enabled in a subsequent release">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M8 7V4h8v3M3 12h18M10 12v2h4v-2"></path></svg>
                    <span>My Assets</span><small>Later</small>
                </span>
            </nav>

            <div class="sidebar-bottom">
                <div class="sidebar-help">
                    <div class="help-icon">?</div>
                    <div><strong>Need assistance?</strong><span>Contact your administrator</span></div>
                </div>
                <form asp-controller="Login" asp-action="Logout" asp-route-client="@clientSlug" method="post" class="sidebar-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-logout">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3M13 4h5a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-5"></path></svg>
                        <span>Sign out</span>
                    </button>
                </form>
                <div class="sidebar-version">WebStaffSync <span>v1.0</span></div>
            </div>
        </aside>

        <div class="sidebar-scrim" id="sidebarScrim"></div>

        <div class="app-main">
            <header class="topbar">
                <div class="topbar-left">
                    <button type="button" class="icon-button sidebar-toggle" id="sidebarToggle" aria-label="Toggle navigation" aria-expanded="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    </button>
                    <div class="topbar-breadcrumb"><span>My Workspace</span><i>/</i><strong>@pageTitle</strong></div>
                </div>
                <div class="topbar-right">
                    <div class="topbar-date" id="todayDate"></div>
                    <div class="topbar-divider"></div>
                    <div class="topbar-user">
                        <div class="avatar avatar-top">@initials</div>
                        <div class="topbar-user-copy"><strong>@employeeName</strong><span>Employee</span></div>
                    </div>
                </div>
            </header>

            <main class="page-content" role="main">
                @RenderBody()
                <footer class="page-footer">
                    <span>© @DateTime.Now.Year WebStaffSync</span>
                    <span>Employee Self-Service Portal</span>
                </footer>
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
