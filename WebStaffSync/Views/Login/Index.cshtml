@model WebStaffSync.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Employee Sign In";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sign In | StaffSync</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <main class="login-shell">
        <section class="welcome-panel" aria-label="StaffSync introduction">
            <div class="brand">
                <div class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                <span>Staff<span class="brand-light">Sync</span></span>
            </div>
            <div class="welcome-copy">
                <div class="eyebrow">EMPLOYEE SELF-SERVICE</div>
                <h1>Your work life,<br />in one place.</h1>
                <p>Access your attendance, leave, payroll and employee information through your secure personal workspace.</p>
            </div>
            <div class="welcome-footer"><span class="secure-dot"></span>A personal and secure employee portal</div>
            <div class="decor decor-one"></div><div class="decor decor-two"></div>
        </section>

        <section class="form-panel" aria-label="Employee sign in">
            <div class="mobile-brand">
                <div class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                <span>Staff<span class="brand-light">Sync</span></span>
            </div>
            <div class="login-card">
                <div class="form-heading">
                    <div class="welcome-label">WELCOME BACK</div>
                    <h2>Sign in to your account</h2>
                    <p>Enter your employee account details to continue.</p>
                </div>

                <form asp-controller="Login" asp-action="Index" method="post" autocomplete="on">
                    @Html.AntiForgeryToken()
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="login-message visible" role="alert"></div>
                    }

                    <div class="field-group">
                        <label asp-for="UserName">Username</label>
                        <div class="input-wrap">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"></circle><path d="M5 20c.7-3.4 3.1-5.2 7-5.2s6.3 1.8 7 5.2"></path></svg>
                            <input asp-for="UserName" type="text" placeholder="Enter your username" autocomplete="username" maxlength="100" />
                        </div>
                        <span asp-validation-for="UserName" class="field-validation-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Password">Password</label>
                        <div class="input-wrap">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4.5" y="10" width="15" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
                            <input asp-for="Password" type="password" placeholder="Enter your password" autocomplete="current-password" maxlength="256" />
                            <button class="password-toggle" type="button" id="togglePassword" aria-label="Show password">Show</button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="form-options">
                        <span class="security-note"><span class="small-lock">●</span> Secure employee access</span>
                        <span class="help-text">Need help signing in? Contact your administrator.</span>
                    </div>

                    <button class="sign-in-button" type="submit">Sign In <span aria-hidden="true">→</span></button>
                </form>
            </div>
            <footer class="form-footer"><span>© 2026 StaffSync</span><span>Employee Self-Service Portal</span></footer>
        </section>
    </main>

    <script>
        const passwordInput = document.getElementById("Password");
        const togglePassword = document.getElementById("togglePassword");
        togglePassword.addEventListener("click", function () {
            const showPassword = passwordInput.type === "password";
            passwordInput.type = showPassword ? "text" : "password";
            togglePassword.textContent = showPassword ? "Hide" : "Show";
            togglePassword.setAttribute("aria-label", showPassword ? "Hide password" : "Show password");
        });
    </script>
</body>
</html>
