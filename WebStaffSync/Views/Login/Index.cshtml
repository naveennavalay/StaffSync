@{
    Layout = null;
    ViewData["Title"] = "Employee Sign In";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sign In | StaffSync</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <main class="login-shell">
        <section class="welcome-panel" aria-label="StaffSync introduction">
            <div class="brand">
                <div class="brand-mark" aria-hidden="true">
                    <span></span><span></span><span></span><span></span>
                </div>
                <span>Staff<span class="brand-light">Sync</span></span>
            </div>

            <div class="welcome-copy">
                <div class="eyebrow">EMPLOYEE SELF-SERVICE</div>
                <h1>Your work life,<br />in one place.</h1>
                <p>Access your attendance, leave, payroll and employee information through your secure personal workspace.</p>
            </div>

            <div class="welcome-footer">
                <span class="secure-dot"></span>
                A personal and secure employee portal
            </div>
            <div class="decor decor-one"></div>
            <div class="decor decor-two"></div>
        </section>

        <section class="form-panel" aria-label="Employee sign in">
            <div class="mobile-brand">
                <div class="brand-mark" aria-hidden="true">
                    <span></span><span></span><span></span><span></span>
                </div>
                <span>Staff<span class="brand-light">Sync</span></span>
            </div>

            <div class="login-card">
                <div class="form-heading">
                    <div class="welcome-label">WELCOME BACK</div>
                    <h2>Sign in to your account</h2>
                    <p>Enter your employee account details to continue.</p>
                </div>

                <form id="loginForm" autocomplete="on">
                    <div class="field-group">
                        <label for="username">Username</label>
                        <div class="input-wrap">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="8" r="3.5"></circle>
                                <path d="M5 20c.7-3.4 3.1-5.2 7-5.2s6.3 1.8 7 5.2"></path>
                            </svg>
                            <input id="username" name="username" type="text"
                                   placeholder="Enter your username" autocomplete="username"
                                   required maxlength="100" />
                        </div>
                    </div>

                    <div class="field-group">
                        <label for="password">Password</label>
                        <div class="input-wrap">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="4.5" y="10" width="15" height="10" rx="2"></rect>
                                <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                            </svg>
                            <input id="password" name="password" type="password"
                                   placeholder="Enter your password" autocomplete="current-password"
                                   required maxlength="256" />
                            <button class="password-toggle" type="button" id="togglePassword"
                                    aria-label="Show password">Show</button>
                        </div>
                    </div>

                    <div class="form-options">
                        <span class="security-note"><span class="small-lock">●</span> Secure employee access</span>
                        <span class="help-text">Need help signing in? Contact your administrator.</span>
                    </div>

                    <button class="sign-in-button" type="submit">
                        Sign In <span aria-hidden="true">→</span>
                    </button>
                    <p id="loginMessage" class="login-message" role="status" aria-live="polite">
                        Sign-in authentication will be connected in the next implementation step.
                    </p>
                </form>
            </div>

            <footer class="form-footer">
                <span>© 2026 StaffSync</span>
                <span>Employee Self-Service Portal</span>
            </footer>
        </section>
    </main>

    <script>
        const passwordInput = document.getElementById("password");
        const togglePassword = document.getElementById("togglePassword");
        const loginForm = document.getElementById("loginForm");
        const loginMessage = document.getElementById("loginMessage");

        togglePassword.addEventListener("click", function () {
            const showPassword = passwordInput.type === "password";
            passwordInput.type = showPassword ? "text" : "password";
            togglePassword.textContent = showPassword ? "Hide" : "Show";
            togglePassword.setAttribute("aria-label", showPassword ? "Hide password" : "Show password");
        });

        loginForm.addEventListener("submit", function (event) {
            event.preventDefault();
            loginMessage.textContent = "The sign-in screen is ready. Secure authentication will be connected in the next step.";
            loginMessage.classList.add("visible");
        });
    </script>
</body>
</html>
