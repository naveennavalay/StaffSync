@{
    ViewData["Title"] = "My Leaves";
    ViewData["PageTitle"] = "My Leaves";
    ViewData["PageDescription"] = "View your leave balances, entitlement details and leave history.";
}

<style>
    .leaves-page {
        color: #183153;
    }

    .leaves-page .page-eyebrow {
        color: #3978ef;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .leaves-page .page-title {
        color: #183153;
        font-size: 27px;
        font-weight: 700;
        margin: 0 0 5px;
    }

    .leaves-page .page-description {
        color: #8292aa;
        font-size: 13px;
        margin: 0;
    }

    .leaves-page .page-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 13px;
        border: 1px solid #d9eee6;
        border-radius: 9px;
        background: #f3fbf7;
        color: #218b6d;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    .leaves-page .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #27ad85;
    }

    .leaves-page .leave-panel {
        background: #fff;
        border: 1px solid #e4eaf3;
        border-radius: 12px;
        box-shadow: 0 5px 18px rgba(26, 52, 89, .035);
        overflow: hidden;
    }

    .leaves-page .panel-heading {
        color: #24466f;
        font-size: 15px;
        font-weight: 700;
        margin: 0 0 5px;
    }

    .leaves-page .panel-subtitle {
        color: #8a9ab1;
        font-size: 11px;
        margin: 0;
    }

    .leaves-page .leave-summary-card {
        height: 100%;
        padding: 18px 20px;
        background: #fff;
        border: 1px solid #e4eaf3;
        border-radius: 11px;
        box-shadow: 0 4px 14px rgba(26, 52, 89, .025);
    }

    .leaves-page .summary-label {
        color: #8292aa;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .leaves-page .summary-value {
        color: #24466f;
        font-size: 25px;
        font-weight: 700;
        line-height: 1.1;
    }

    .leaves-page .summary-note {
        color: #9aa8ba;
        font-size: 10px;
        margin-top: 7px;
    }

    .leaves-page .summary-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #edf4ff;
        color: #3978ef;
        font-size: 17px;
    }

    .leaves-page .data-placeholder {
        min-height: 190px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 26px;
    }

    .leaves-page .placeholder-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: #edf4ff;
        color: #3978ef;
        font-size: 23px;
        margin-bottom: 13px;
    }

    .leaves-page .placeholder-title {
        color: #24466f;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .leaves-page .placeholder-text {
        color: #8797ad;
        font-size: 12px;
        max-width: 470px;
        line-height: 1.6;
        margin: 0;
    }

    .leaves-page .weekly-off-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 18px;
        background: #f8fafd;
        border-top: 1px solid #edf1f6;
        color: #536983;
        font-size: 12px;
    }

    .leaves-page .weekly-off-value {
        color: #24466f;
        font-weight: 600;
    }

    @@media (max-width: 767px) {
        .leaves-page .page-heading {
            align-items: flex-start !important;
            flex-direction: column;
            gap: 14px;
        }
    }
</style>

<div class="leaves-page">
    <div class="d-flex justify-content-between align-items-center page-heading mb-4">
        <div>
            <div class="page-eyebrow">Employee Self-Service</div>
            <h1 class="page-title">My Leaves</h1>
            <p class="page-description">
                View your leave balances, entitlement details and leave history.
            </p>
        </div>

        <div class="page-status">
            <span class="status-dot"></span>
            Leave overview
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="leave-summary-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="summary-label">Total Leaves Allotted</div>
                        <div class="summary-value">—</div>
                        <div class="summary-note">For the applicable leave period</div>
                    </div>
                    <div class="summary-icon" aria-hidden="true">▤</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="leave-summary-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="summary-label">Available Balance</div>
                        <div class="summary-value">—</div>
                        <div class="summary-note">Leaves currently available</div>
                    </div>
                    <div class="summary-icon" aria-hidden="true">◷</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="leave-summary-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="summary-label">Used Leaves</div>
                        <div class="summary-value">—</div>
                        <div class="summary-note">Leaves already utilised</div>
                    </div>
                    <div class="summary-icon" aria-hidden="true">✓</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="leave-summary-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="summary-label">Pending Requests</div>
                        <div class="summary-value">—</div>
                        <div class="summary-note">Awaiting approval</div>
                    </div>
                    <div class="summary-icon" aria-hidden="true">◷</div>
                </div>
            </div>
        </div>
    </div>

    <section class="leave-panel mb-4">
        <div class="p-4 border-bottom">
            <h2 class="panel-heading">Leave Balance</h2>
            <p class="panel-subtitle">
                Leave entitlement and balance by leave type.
            </p>
        </div>

        <div class="data-placeholder">
            <div class="placeholder-icon" aria-hidden="true">▦</div>
            <div class="placeholder-title">Leave balances will appear here</div>
            <p class="placeholder-text">
                The leave balance grid will display Leave Type, Total Leaves Allotted,
                Balance Leaves and Used Leaves using the employee-specific leave data.
            </p>
        </div>

        <div class="weekly-off-row">
            <span>Weekly Off</span>
            <span class="weekly-off-value">—</span>
        </div>
    </section>

    <section class="leave-panel">
        <div class="p-4 border-bottom">
            <h2 class="panel-heading">Leave History</h2>
            <p class="panel-subtitle">
                Your submitted leave requests and their current status.
            </p>
        </div>

        <div class="data-placeholder">
            <div class="placeholder-icon" aria-hidden="true">▤</div>
            <div class="placeholder-title">Leave history will appear here</div>
            <p class="placeholder-text">
                Your leave transactions will be displayed here with leave dates,
                leave type, duration and approval status once connected to the
                existing StaffSync leave APIs.
            </p>
        </div>
    </section>
</div>
