                            $("<td/>", { text: employee.designation, css: { padding: ".6rem", borderBottom: "1px solid #edf2f7" } }),
                            $("<td/>", { text: employee.department, css: { padding: ".6rem", borderBottom: "1px solid #edf2f7" } })
                        );
                        fallbackBody.append(row);
                    });
                    treeListFallback.append(fallbackBody);
                    $("#demoEmployeeTreeList").empty().append(treeListFallback);
                    console.warn("Kendo TreeList is not available in this bundle; employee hierarchy sample table is displayed.");
                }
            } catch (treeListError) {
                console.error("TreeList initialization failed:", treeListError);
            }

            // TimePicker: sample employee shift start/end times.
            try {
                if (typeof $.fn.kendoTimePicker === "function") {
                    $("#demoShiftStartTime").kendoTimePicker({
                        format: "hh:mm tt",
                        interval: 15,
                        value: new Date(2026, 10, 22, 9, 0)
                    });
                    $("#demoShiftEndTime").kendoTimePicker({
                        format: "hh:mm tt",
                        interval: 15,
                        value: new Date(2026, 10, 22, 18, 0)
                    });
                } else {
                    console.warn("Kendo TimePicker is not available in the loaded Kendo bundle.");
                }
            } catch (timePickerError) {
                console.error("TimePicker initialization failed:", timePickerError);
            }

            // RadioButton and RadioGroup widgets are not present in every
            // legacy Kendo UI for jQuery release. Native accessible radio
            // controls are used here to keep both groups fully functional.

            // $("#demoSave").on("click", function () {
            //     var departments = $("#demoMultiSelect").data("kendoMultiSelect").value().join(", ");
            //     var designation = $("#demoDropDown").data("kendoDropDownList").value();
