                            ),
                            $("<span/>").text(employee.role)
                        ).appendTo(fallbackList);
                    });
                    $("#demoEmployeeListView").empty().append(fallbackList.children());
                    console.warn("Kendo ListView is not available in the loaded Kendo build; styled list fallback is active.");
                }
            } catch (listViewError) {
                console.error("ListView initialization failed:", listViewError);
            }


            // Timeline: use the Kendo widget when it is included in the active
            // bundle; otherwise render the same sample events as a simple timeline.
            var demoTimelineData = [
                { date: new Date(2020, 0, 6), title: "Joined StaffSync", subtitle: "06-Jan-2020", description: "Employee onboarding completed. Employee Code: EMP-0001." },
                { date: new Date(2022, 1, 1), title: "Role Updated", subtitle: "01-Feb-2022", description: "Moved into the Technical Specialist role in Information Technology." },
                { date: new Date(2024, 5, 15), title: "Training Completed", subtitle: "15-Jun-2024", description: "Completed advanced application support training." },
                { date: new Date(2026, 10, 1), title: "Profile Reviewed", subtitle: "01-Nov-2026", description: "Employee profile information reviewed and confirmed." }
            ];

            try {
                if (typeof $.fn.kendoTimeline === "function") {
                    $("#demoEmployeeTimeline").kendoTimeline({
                        orientation: "vertical",
                        alternatingMode: false,
                        collapsibleEvents: false,
                        dataSource: { data: demoTimelineData },
                        dateField: "date",
                        titleField: "title",
                        descriptionField: "description"
                    });
                } else {
                    var timelineFallback = $("<div/>", { "class": "profile-demo-timeline-fallback" });
                    demoTimelineData.forEach(function (eventItem) {
                        var eventDate = eventItem.date.toLocaleDateString("en-GB", {
                            day: "2-digit", month: "short", year: "numeric"
                        });
                        var item = $("<div/>", { "class": "profile-demo-timeline-item" });
                        item.append(
                            $("<div/>", { "class": "profile-demo-timeline-date" }).text(eventItem.subtitle || eventDate),
                            $("<strong/>").text(eventItem.title),
                            $("<div/>").text(eventItem.description)
