@model WebStaffSync.Models.MyProfileViewModel
@using System.Text.Json
@using System.Net
@{
    ViewData["Title"] = "My Profile";
    var tabs = new[] {
        ("personal", "Personal Info"), ("professional", "Professional Info"),
        ("photo", "Photo"), ("family", "Family Members"), ("experience", "Previous Experience"),
        ("skills", "Skills"), ("education", "Educational Info"), ("documents", "Documents"),
        ("leaves", "Leaves"), ("bank", "Bank Account Info"), ("statutory", "Statutory Information"),
        ("salary", "Salary Profile")
    };
}

@section Styles {
    @* <link href="https://cdn.jsdelivr.net/npm/@@progress/kendo-theme-meridian@14.9.0/dist/meridian-main.css" rel="stylesheet" /> *@
    <link rel="stylesheet" href="~/css/my-profile.css" asp-append-version="true" />

    <style>
        /* Kendo widgets inherit the existing StaffSync profile layout and spacing. */
        .profile-kendo-grid {
            width: 100%;
            min-width: 0;
        }

            .profile-kendo-grid .k-grid-header th {
                font-weight: 700;
            }

        .profile-field-grid {
            display: none;
        }

        .profile-table-wrap {
            display: none;
        }

        .profile-tags {
            display: none;
        }

        .profile-readonly-tags {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
            padding: .35rem 0;
            min-height: 2rem;
        }

        .profile-readonly-tag {
            display: inline-flex;
            align-items: center;
            padding: .4rem .75rem;
            border: 1px solid #d7e2f0;
            border-radius: 999px;
            background: #f3f7fc;
            color: #23456f;
            font-size: .85rem;
            line-height: 1.25;
        }

        .profile-kendo-chips {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
        }

        .profile-photo-preview img {
            max-width: 240px;
            max-height: 300px;
            object-fit: contain;
        }

        #profileTabs > .k-content {
            padding: 1.25rem;
        }

        #profileTabs > .k-tabstrip-items-wrapper {
            overflow-x: auto;
        }

        .profile-empty {
            padding: 1rem;
            color: #718096;
        }

        .profile-demo-showcase {
            margin: 1rem 0 1.25rem;
            padding: 1.25rem;
            border: 1px solid #dce6ef;
            border-radius: 12px;
            background: #f8fbff;
        }

        .profile-demo-tag {
            display: inline-block;
            padding: .35rem .65rem;
            border-radius: 999px;
            background: #e7f2ff;
            color: #245b91;
            font-size: .7rem;
            font-weight: 700;
        }

        .profile-demo-card {
            margin: 1rem 0;
            padding: 1.1rem;
            border: 1px solid #dce6ef;
            border-radius: 10px;
            background: #fff;
        }

            .profile-demo-card h3 {
                margin: 0 0 1rem;
                color: #174f79;
                font-size: 1rem;
            }

        .profile-demo-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(220px, 1fr));
            gap: 1rem 1.25rem;
            align-items: end;
        }

        .profile-demo-field {
            min-width: 0;
        }

            .profile-demo-field > label {
                display: block;
                margin-bottom: .4rem;
                color: #294b64;
                font-weight: 600;
                font-size: .875rem;
            }

            .profile-demo-field > input:not([type="checkbox"]), .profile-demo-field > select {
                width: 100%;
            }

            .profile-demo-field small {
                display: block;
                margin-top: .3rem;
                color: #718096;
            }

        .profile-demo-checkbox {
            display: flex;
            align-items: center;
            gap: .55rem;
            min-height: 40px;
        }

            .profile-demo-checkbox label {
                margin: 0;
            }

        .profile-demo-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .65rem;
            margin-top: 1.1rem;
        }

        #demoActionMessage {
            color: #187344;
            font-size: .875rem;
        }

        #demoNestedTabs {
            min-height: 125px;
        }

            #demoNestedTabs .k-content {
                padding: 1rem;
            }

        #demoEmployeeGrid {
            width: 100%;
        }

        .profile-demo-separator {
            margin: 0 .6rem;
            color: #94a3b8;
        }

        /* Additional Kendo component demonstrations */
        .profile-demo-badge-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .75rem;
        }

        .profile-demo-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 2rem;
            min-height: 1.6rem;
            padding: .2rem .65rem;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 700;
            line-height: 1.2;
        }

        .profile-demo-badge-primary {
            background: #e7f2ff;
            color: #245b91;
        }

        .profile-demo-badge-success {
            background: #e5f7ed;
            color: #187344;
        }

        .profile-demo-badge-warning {
            background: #fff4d6;
            color: #946200;
        }

        .profile-demo-badge-danger {
            background: #fde8e8;
            color: #a12626;
        }

        .profile-demo-listbox {
            width: 100%;
        }

        /* Explicit ListBox layout for the current Kendo theme/build.
                                           Some older Kendo bundles do not apply the expected flex layout. */
        .profile-demo-card .k-listbox {
            display: flex !important;
            flex-direction: row !important;
            align-items: stretch !important;
            gap: .5rem;
            width: 100%;
            height: 220px;
            min-height: 220px;
            box-sizing: border-box;
        }

            .profile-demo-card .k-listbox .k-list-scroller {
                display: block !important;
                order: 1;
                flex: 1 1 auto;
                width: auto !important;
                min-width: 0;
                height: 220px;
                min-height: 220px;
                overflow-y: auto;
                border: 1px solid #cbd5e1;
                border-radius: 4px;
                background: #fff;
            }

            .profile-demo-card .k-listbox .k-list {
                display: block;
                min-height: 200px;
                margin: 0;
                padding: .25rem;
            }

            .profile-demo-card .k-listbox .k-list-item,
            .profile-demo-card .k-listbox .k-item {
                display: block;
                padding: .45rem .65rem;
                cursor: pointer;
                border-radius: 3px;
            }

                .profile-demo-card .k-listbox .k-list-item.k-selected,
                .profile-demo-card .k-listbox .k-item.k-state-selected {
                    background: #dcecff;
                    color: #174f79;
                }

            .profile-demo-card .k-listbox .k-listbox-toolbar {
                display: flex !important;
                flex: 0 0 38px;
                order: 2;
                flex-direction: column !important;
                justify-content: center;
                align-items: stretch;
                gap: .35rem;
                width: 38px;
                margin: 0;
            }

                .profile-demo-card .k-listbox .k-listbox-toolbar .k-button {
                    min-width: 34px;
                    margin: 0;
                }

        .profile-demo-listview {
            width: 100%;
            min-height: 190px;
        }

        .profile-demo-listview-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            padding: .75rem .9rem;
            border-bottom: 1px solid #e5edf5;
        }

            .profile-demo-listview-item:last-child {
                border-bottom: 0;
            }

        .profile-demo-listview-meta {
            color: #718096;
            font-size: .8rem;
        }

        /* Timeline, TreeView, TreeList and TimePicker demo layout */
        .profile-demo-timeline {
            min-height: 120px;
            padding: .75rem;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: #fff;
        }

        .profile-demo-timeline-fallback {
            display: grid;
            gap: .85rem;
        }

        .profile-demo-timeline-item {
            position: relative;
            padding: .25rem .5rem .75rem 1.25rem;
            border-left: 2px solid #b8d2ee;
        }

            .profile-demo-timeline-item::before {
                content: "";
                position: absolute;
                left: -.42rem;
                top: .35rem;
                width: .7rem;
                height: .7rem;
                border-radius: 50%;
                background: #3478df;
            }

        .profile-demo-timeline-date {
            color: #64748b;
            font-size: .78rem;
            margin-bottom: .2rem;
        }

        .profile-demo-tree,
        .profile-demo-treelist {
            width: 100%;
            min-height: 180px;
        }

        .profile-demo-tree-fallback ul {
            margin: .25rem 0 .25rem 1.2rem;
            padding-left: 1rem;
        }

        .profile-demo-tree-fallback li {
            padding: .2rem 0;
        }

        .profile-demo-timepicker {
            max-width: 280px;
        }

        .profile-demo-radio-group {
            display: flex;
            flex-wrap: wrap;
            gap: .75rem 1.25rem;
            padding: .85rem;
            border: 1px solid #dce6ef;
            border-radius: 8px;
        }

            .profile-demo-radio-group label {
                display: inline-flex;
                align-items: center;
                gap: .45rem;
                margin: 0;
                font-weight: 500;
            }

            .profile-demo-radio-group input[type="radio"] {
                accent-color: #3478df;
            }

        /*         @@ media (max-width: 700px) {
                                                    .profile-demo-grid {
                                                        grid-template-columns: 1fr;
                                                    }
                                                } */

        /* Calm, low-contrast profile grids: soft sage/blue surfaces and readable typography. */
        .profile-workspace,
        .profile-workspace .k-widget,
        .profile-workspace .k-grid,
        .profile-workspace .k-tabstrip {
            font-family: "Segoe UI", Arial, sans-serif;
        }

            .profile-workspace .profile-records-grid .k-grid-header th {
                background: #edf2ef;
                color: #30443d;
                border-color: #d8e2dc;
                font-weight: 600;
            }

            .profile-workspace .profile-records-grid .k-grid-content td {
                color: #34443e;
                border-color: #e4ebe6;
            }

            .profile-workspace .profile-records-grid .k-grid-content tr:nth-child(odd) td {
                background: #fbfcfa;
            }

            .profile-workspace .profile-records-grid .k-grid-content tr:nth-child(even) td {
                background: #f1f5f2;
            }

            .profile-workspace .profile-records-grid .k-grid-content tr:hover td {
                background: #e8f0eb;
            }

            .profile-workspace .profile-records-grid .k-pager-wrap {
                background: #f5f7f5;
                border-color: #dfe7e1;
                color: #52635b;
            }

            .profile-workspace .k-tabstrip-items .k-item {
                background: #f3f5f4;
                color: #52615a;
            }

                .profile-workspace .k-tabstrip-items .k-item.k-active {
                    background: #ffffff;
                    color: #294c3e;
                }

        .profile-bank-table-wrap {
            width: 100%;
            overflow-x: auto;
            margin-top: .75rem;
            border: 1px solid #d9e1ea;
            border-radius: 6px;
            background: #fff;
        }

        .profile-bank-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .profile-bank-table th,
            .profile-bank-table td {
                padding: .65rem .8rem;
                border-bottom: 1px solid #e5eaf0;
                text-align: left;
                vertical-align: top;
                overflow-wrap: anywhere;
                font-size: .9rem;
            }

            .profile-bank-table thead th {
                background: #f3f5f7;
                color: #334155;
                font-weight: 600;
            }

            .profile-bank-table tbody th {
                width: 38%;
                background: #fafbfc;
                color: #334155;
                font-weight: 500;
            }

            .profile-bank-table tbody tr:last-child th,
            .profile-bank-table tbody tr:last-child td {
                border-bottom: 0;
            }
    </style>
}

<div class="page-heading profile-page-heading">
    <div>
        <div class="page-eyebrow">EMPLOYEE SELF-SERVICE</div>
        <h1>My Profile</h1>
        <p>View your employee information maintained by your organisation.</p>
    </div>
    <div class="profile-readonly-note"><span>✓</span> Read-only profile</div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <section class="profile-message profile-message-warning" role="status">
        <strong>Profile information unavailable</strong>
        <p>@Model.ErrorMessage</p>
    </section>
}

<section class="profile-identity-card">
    <div class="profile-avatar">
        @if (!string.IsNullOrWhiteSpace(Model.PhotoDataUrl))
        {
            <img src="@Model.PhotoDataUrl" alt="Employee photograph" />
        }
        else
        {
            var initials = string.Join("", (Model.EmployeeName ?? "Employee").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[..1].ToUpperInvariant()));
            <span>@initials</span>
        }
    </div>
    <div class="profile-identity-copy">
        <span class="profile-kicker">EMPLOYEE PROFILE</span>
        <h2>@(Model.EmployeeName ?? "Employee")</h2>
        <div class="profile-identity-meta">
            <span>Employee Code: <strong>@(Model.EmployeeCode ?? "—")</strong></span>
            <span class="profile-status">@(!string.IsNullOrWhiteSpace(Model.Status) ? Model.Status : "Status unavailable")</span>
        </div>
    </div>
    <div class="profile-lock-mark" title="Information is read-only">▣</div>
</section>

