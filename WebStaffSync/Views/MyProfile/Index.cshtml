        </div>
    </div>
</section>




@functions {
    // Render bank information directly as HTML instead of creating a Kendo Grid.
    // This avoids relying on the client-side Kendo initialization for this small section.
    private Microsoft.AspNetCore.Html.IHtmlContent BankInformationTable(
        IEnumerable<WebStaffSync.Models.ProfileField>? fields)
    {
        var source = fields?.ToList() ?? new List<WebStaffSync.Models.ProfileField>();

        string Normalize(string? value) => new string(
            (value ?? string.Empty).Where(char.IsLetterOrDigit).ToArray());

        string FindValue(params string[] aliases)
        {
            foreach (var alias in aliases)
            {
                var expected = Normalize(alias);
                var match = source.FirstOrDefault(f =>
                    string.Equals(Normalize(f.Label), expected, StringComparison.OrdinalIgnoreCase));

                if (match != null && !string.IsNullOrWhiteSpace(match.Value))
                    return match.Value.Trim();
            }

            return "—";
        }

        var rows = new[]
        {
            new { Label = "Bank Name", Value = FindValue("BankName", "Bank Name") },
            new { Label = "Bank Address", Value = FindValue("BankAddress", "Bank Address") },
            new { Label = "Account Number", Value = FindValue("EmpACNumber", "AccountNumber", "EmpAccountNumber", "Account Number") }
        };

        var encoder = System.Text.Encodings.Web.HtmlEncoder.Default;
        var html = new System.Text.StringBuilder();
        html.Append("<div class=\"profile-bank-table-wrap\"><table class=\"profile-bank-table\"><thead><tr><th>Attribute</th><th>Value</th></tr></thead><tbody>");

        foreach (var row in rows)
        {
            html.Append("<tr><th scope=\"row\">")
                .Append(encoder.Encode(row.Label))
                .Append("</th><td>")
                .Append(encoder.Encode(row.Value))
                .Append("</td></tr>");
        }

        html.Append("</tbody></table></div>");
        return new Microsoft.AspNetCore.Html.HtmlString(html.ToString());
    }

    private Microsoft.AspNetCore.Html.IHtmlContent Fields(IEnumerable<WebStaffSync.Models.ProfileField>? fields)
    {
        var items = fields?.Select(f => new { Label = f.Label, Value = string.IsNullOrWhiteSpace(f.Value) ? "—" : f.Value }).ToList();
        if (items == null || items.Count == 0)
            return new Microsoft.AspNetCore.Html.HtmlString("<div class=\"profile-empty\">No information available.</div>");

        var json = JsonSerializer.Serialize(items);
        return new Microsoft.AspNetCore.Html.HtmlString(
            "<div class=\"profile-kendo-grid profile-fields-grid\" data-grid='" + WebUtility.HtmlEncode(json) + "'></div>");
    }

    private Microsoft.AspNetCore.Html.IHtmlContent Tags(IEnumerable<string>? values)
    {
        var items = values?
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList() ?? new();

        if (items.Count == 0)
            return new Microsoft.AspNetCore.Html.HtmlString("<div class=\"profile-empty\">No information available for this employee.</div>");

        // Render the already-resolved employee skill/qualification names as safe,
        // read-only tags. This avoids relying on the optional Kendo ChipList module.
        var tags = string.Join("", items.Select(x =>
            "<span class=\"profile-readonly-tag\">" + WebUtility.HtmlEncode(x) + "</span>"));

        return new Microsoft.AspNetCore.Html.HtmlString(
            "<div class=\"profile-readonly-tags\">" + tags + "</div>");
    }


    private Microsoft.AspNetCore.Html.IHtmlContent Table(
        IEnumerable<WebStaffSync.Models.ProfileRow>? rows,
        string[] preferredColumns,
        IEnumerable<WebStaffSync.Models.ProfileGridColumn>? columnMetadata = null,
        bool onlyPreferredColumns = false,
        bool formatPreferredColumnsAsDecimal = false)
    {
        var items = rows?
            .Where(r => r != null && r.Values != null && r.Values.Count > 0)
            .ToList() ?? new();

        if (items.Count == 0)
            return new Microsoft.AspNetCore.Html.HtmlString(
                "<div class=\"profile-empty\">No information available for this employee.</div>");

        // Collect all actual source column names.
        var actualKeys = items
            .SelectMany(x => x.Values.Keys)
            .Where(k => !string.IsNullOrWhiteSpace(k))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        // Resolve preferred headings to the actual source keys.
        // This supports metadata display titles such as "Salary Header" mapping
        // to the source key "Header Title".
        var metadataItems = (columnMetadata ??
            Enumerable.Empty<WebStaffSync.Models.ProfileGridColumn>()).ToList();

        var matchedPreferred = preferredColumns
            .Select(preferred =>
            {
                // First try an exact source-key match.
                var directMatch = actualKeys.FirstOrDefault(k =>
                    string.Equals(k, preferred, StringComparison.OrdinalIgnoreCase));

                if (!string.IsNullOrWhiteSpace(directMatch))
                    return directMatch;

                // Otherwise resolve the friendly display title through metadata.
                var metadataMatch = metadataItems.FirstOrDefault(m =>
                    string.Equals(m.Title, preferred, StringComparison.OrdinalIgnoreCase));

                if (metadataMatch == null || string.IsNullOrWhiteSpace(metadataMatch.SourceName))
                    return null;

                return actualKeys.FirstOrDefault(k =>
                    string.Equals(k, metadataMatch.SourceName, StringComparison.OrdinalIgnoreCase));
            })
            .Where(k => !string.IsNullOrWhiteSpace(k))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        // Most profile grids retain additional returned fields. The Leave grid
        // explicitly opts into an allow-list so internal/configuration columns
        // are not rendered.
        var columns = onlyPreferredColumns
            ? matchedPreferred
            : matchedPreferred
                .Concat(actualKeys.Where(k =>
                    !matchedPreferred.Contains(k, StringComparer.OrdinalIgnoreCase)))
                .ToList();

        var data = items.Select(row =>
        {
            var record = new Dictionary<string, string>(
                StringComparer.OrdinalIgnoreCase);

            foreach (var col in columns)
            {
                var value = row.Values.TryGetValue(col, out var raw)
                    ? raw
                    : null;

                record[col] = string.IsNullOrWhiteSpace(value)
                    ? "—"
                    : value;
            }

            return record;
        }).ToList();

        // Serialize metadata using predictable camelCase property names.
        var metadata = metadataItems
            .Select(c => new
            {
                field = c.Field,
                sourceName = c.SourceName,
                title = c.Title,
                visible = c.Visible,
                width = c.Width,
                alignment = c.Alignment,
                format = c.Format,
                dataType = c.DataType,
                sortable = c.Sortable,
                filterable = c.Filterable,
                groupable = c.Groupable,
                resizable = c.Resizable,
                reorderable = c.Reorderable,
                sortOrder = c.SortOrder,
                sortDirection = c.SortDirection,
                groupOrder = c.GroupOrder,
                locked = c.Locked,
                lockable = c.Lockable,
                exportable = c.Exportable,
                kendoOptionsJson = c.KendoOptionsJson
            })
            .ToList();

        var payload = JsonSerializer.Serialize(new
        {
            columns,
            data,
            columnMetadata = metadata,
            formatPreferredColumnsAsDecimal
        });

        return new Microsoft.AspNetCore.Html.HtmlString(
            "<div class=\"profile-kendo-grid profile-records-grid\" data-grid='" +
            WebUtility.HtmlEncode(payload) + "'></div>");
    }

}

@section Scripts {
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2017.1.223/styles/kendo.default.min.css" />
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2017.1.223/styles/kendo.default.mobile.min.css" />
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2017.1.223/styles/kendo.common.min.css" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://unpkg.com/jszip/dist/jszip.min.js"></script>

    <script src="https://kendo.cdn.telerik.com/2017.1.223/js/kendo.all.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2017.1.223/js/kendo.aspnetmvc.min.js"></script>
    <script src="~/js/staffsync-kendo-grid.js" asp-append-version="true"></script>

    <script>
        (function ($, kendo) {
            "use strict";

            if (!$ || !kendo) {
                console.error("Kendo UI for jQuery could not be loaded. Verify jQuery and Kendo CDN responses.");
                return;
            }

            if (!$.fn || typeof $.fn.kendoTabStrip !== "function" ||
                typeof $.fn.kendoGrid !== "function") {
                console.error("Kendo TabStrip/Grid widgets are unavailable. Check that the Kendo bundle loaded after jQuery.");
                return;
            }


            // Demo-only Kendo controls. These values are never posted or saved.
            $("#demoMultiSelect").kendoMultiSelect({ placeholder: "Select departments..." });
            $("#demoDropDown").kendoDropDownList();
            $("#demoAlphaNumeric").on("input", function () {
                this.value = this.value.replace(/[^a-z0-9]/gi, "");
            });
            $("#demoNumeric").kendoNumericTextBox({ format: "n0", decimals: 0, restrictDecimals: true, min: 0 });
            //$("#demoActive").kendoCheckBox();
            $("#demoNestedTabs").kendoTabStrip({ animation: false });

            var demoEmployees = [
                { employeeCode: "EMP-0001", employeeName: "S. Kumar", department: "Information Technology", designation: "Technical Specialist", status: "Active" },
                { employeeCode: "EMP-0002", employeeName: "A. Sharma", department: "Finance", designation: "Accountant", status: "Active" },
                { employeeCode: "EMP-0003", employeeName: "P. Reddy", department: "Human Resources", designation: "HR Executive", status: "Active" },
                { employeeCode: "EMP-0004", employeeName: "M. Patel", department: "Operations", designation: "Operations Manager", status: "On Leave" },
                { employeeCode: "EMP-0005", employeeName: "R. Nair", department: "Sales", designation: "Sales Executive", status: "Active" },
                { employeeCode: "EMP-0006", employeeName: "K. Das", department: "Information Technology", designation: "Software Engineer", status: "Inactive" }
            ];
            $("#demoEmployeeGrid").kendoGrid({
                dataSource: { data: demoEmployees, pageSize: 5 },
                columns: [
                    { field: "employeeCode", title: "Employee Code", width: 130 },
                    { field: "employeeName", title: "Employee Name" },
                    { field: "department", title: "Department" },
                    { field: "designation", title: "Designation" },
                    { field: "status", title: "Status", width: 110 }
                ],
                sortable: true, filterable: true, pageable: { pageSizes: [5, 10], buttonCount: 3 },
                resizable: true, reorderable: true
            });


            // Additional demo components. Each initializer is isolated so an
            // unsupported widget in the currently loaded Kendo build cannot
            // prevent the other demo controls from rendering.
            try {
                if (typeof $.fn.kendoDatePicker === "function") {
                    $("#demoDatePicker").kendoDatePicker({
                        format: "dd-MMM-yyyy",
                        value: new Date(2026, 10, 22)
                    });
                } else {
                    console.warn("Kendo DatePicker is not available in the loaded Kendo build.");
                }
            } catch (datePickerError) {
                console.error("DatePicker initialization failed:", datePickerError);
            }

            try {
                var availableSkillData = [
                    { text: "C# Development", value: "CSharp" },
                    { text: "SQL Server / MS Access", value: "SQL" },
                    { text: "ASP.NET Core MVC", value: "MVC" },
                    { text: "JavaScript", value: "JavaScript" },
                    { text: "Payroll Processing", value: "Payroll" }
                ];

                var selectedSkillData = [
                    { text: "ASP.NET Core MVC", value: "MVC" },
                    { text: "Payroll Processing", value: "Payroll" }
                ];

                if (typeof $.fn.kendoListBox === "function") {
                    $("#demoAvailableSkills").kendoListBox({
                        dataSource: availableSkillData,
                        height: 220,
                        dataTextField: "text",
                        dataValueField: "value",
                        connectWith: "demoSelectedSkills",
                        selectable: "multiple",
                        toolbar: {
                            position: "right",
                            tools: ["transferTo", "transferFrom", "transferAllTo", "transferAllFrom"]
                        }
                    });

                    $("#demoSelectedSkills").kendoListBox({
                        dataSource: selectedSkillData,
                        height: 220,
                        dataTextField: "text",
                        dataValueField: "value",
                        selectable: "multiple"
                    });
                } else {
                    console.warn("Kendo ListBox is unavailable. The demo will use the native multi-select fallback.");
                    $("#demoAvailableSkills").replaceWith(
                        $("<select multiple size='7' id='demoAvailableSkills' class='profile-demo-listbox' aria-label='Available skills'></select>")
                            .append(availableSkillData.map(function (item) {
                                return $("<option/>", { value: item.value, text: item.text });
                            }))
                    );
                    $("#demoSelectedSkills").replaceWith(
                        $("<select multiple size='7' id='demoSelectedSkills' class='profile-demo-listbox' aria-label='Selected skills'></select>")
                            .append(selectedSkillData.map(function (item) {
                                return $("<option/>", { value: item.value, text: item.text, selected: true });
                            }))
                    );
                }
            } catch (listBoxError) {
                console.error("ListBox initialization failed:", listBoxError);
            }

            var demoListViewData = [
                { name: "S. Kumar", code: "EMP-0001", role: "Technical Specialist" },
                { name: "A. Sharma", code: "EMP-0002", role: "Accountant" },
                { name: "P. Reddy", code: "EMP-0003", role: "HR Executive" },
                { name: "M. Patel", code: "EMP-0004", role: "Operations Manager" }
            ];

            try {
                if (typeof $.fn.kendoListView === "function") {
                    $("#demoEmployeeListView").kendoListView({
                        dataSource: { data: demoListViewData },
                        template:
                            '<div class="profile-demo-listview-item">' +
                                '<div><strong>#: kendo.htmlEncode(name) #</strong>' +
                                '<div class="profile-demo-listview-meta">#: kendo.htmlEncode(code) #</div></div>' +
                                '<span>#: kendo.htmlEncode(role) #</span>' +
                            '</div>'
                    });
                } else {
                    var fallbackList = $("<div/>");
                    demoListViewData.forEach(function (employee) {
                        $("<div/>", {
                            "class": "profile-demo-listview-item"
                        }).append(
