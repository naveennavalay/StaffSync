                        fallbackHead.append($("<th/>", {
                            text: heading,
                            css: { textAlign: "left", padding: ".65rem", borderBottom: "1px solid #dce6ef" }
                        }));
                    });
                    treeListFallback.append($("<thead/>").append(fallbackHead));
                    var fallbackBody = $("<tbody/>");
                    demoEmployeeHierarchy.forEach(function (employee) {
                        var depth = employee.parentId === null ? 0 : (employee.parentId === 2 ? 2 : 1);
                        var row = $("<tr/>");
