            // Read-only profile navigation.
            var tabStrip = $("#profileTabs").kendoTabStrip({
                animation: { open: { effects: "fadeIn" } },
                select: function (e) {
                    // No editing actions are exposed on this page.
                },
                activate: function (e) {
                    // Grids and ChipLists inside hidden tabs must be resized after
                    // their panel becomes visible. This does not change any data.
                    if (kendo && typeof kendo.resize === "function") {
                        kendo.resize($(e.contentElement));
                    }
                }
            }).data("kendoTabStrip");

            // Employee detail fields are rendered as read-only Kendo Grids.
            $(".profile-fields-grid").each(function () {
                var rows = JSON.parse(this.getAttribute("data-grid") || "[]");
                $(this).kendoGrid({
                    dataSource: { data: rows },
                    columns: [
                        { field: "Label", title: "Attribute", width: "38%" },
                        { field: "Value", title: "Value" }
                    ],
                    sortable: false,
                    filterable: false,
                    pageable: false,
                    selectable: false,
                    scrollable: false,
                    noRecords: { template: "No information available." }
                });
            });

            // Repeating profile records use Kendo Grid with sorting, filtering,
            // paging and a column menu for showing/hiding individual columns.
            // Source captions are retained as titles; safe field names are used
            // internally because some API captions contain spaces.
            function profileColumnType(caption, values) {
                var name = String(caption || "").toLowerCase();
                var nonBlank = (values || []).filter(function (value) {
                    return value !== null && value !== undefined && String(value).trim() !== "";
                });

                var booleanName = /(^|[\s_-])is($|[\s_-])|^is/i.test(String(caption || ""));
                var booleanValues = nonBlank.length > 0 && nonBlank.every(function (value) {
                    return typeof value === "boolean" || /^(true|false|yes|no)$/i.test(String(value).trim());
                });
                if (booleanName || booleanValues) return "boolean";

                var dateName = /(date|dob|doj|joining|probation|confirmation|expiry|expire|renewal|relieving|upload)/i.test(name);
                var dateValues = nonBlank.length > 0 && nonBlank.every(function (value) {
                    return value instanceof Date || /^\d{4}-\d{1,2}-\d{1,2}/.test(String(value).trim()) ||
                        /^\d{1,2}[-\/]\d{1,2}[-\/](\d{2}|\d{4})/.test(String(value).trim()) ||
                        /^\d{1,2}-[A-Za-z]{3}-\d{2,4}/.test(String(value).trim()) ||
                        /^\/Date\(-?\d+\)\/$/.test(String(value).trim());
                });
                if (dateName || dateValues) {
                    var hasTime = /(datetime|time|timestamp)/i.test(name) || nonBlank.some(function (value) {
                        return /\d{1,2}:\d{2}/.test(String(value));
                    });
                    return hasTime ? "datetime" : "date";
                }

                var currencyName = /(amount|salary|wage|basic|allowance|deduction|reimbursement|payable|earning|total|balance|advance|rate|cost|price|gross|net)/i.test(name);
                var numericValues = nonBlank.length > 0 && nonBlank.every(function (value) {
                    return typeof value === "number" || /^\(?\s*-?\s*[₹$€£]?\s*\d[\d,]*(\.\d+)?\s*\)?$/.test(String(value).trim());
                });
                if (currencyName && numericValues) return "currency";
                return "string";
            }

            function parseProfileDate(value) {
                if (value instanceof Date) return isNaN(value.getTime()) ? null : value;
                if (value === null || value === undefined || String(value).trim() === "" || value === "—") return null;
                var text = String(value).trim();
                var dotNetDate = text.match(/^\/Date\((-?\d+)\)\/$/);
                if (dotNetDate) return new Date(parseInt(dotNetDate[1], 10));

                // Parse dd-MMM-yyyy [hh:mm:ss AM/PM] without relying on browser locale.
                var namedMonth = text.match(/^(\d{1,2})[-\s]([A-Za-z]{3})[-\s](\d{2,4})(?:\s+(\d{1,2}):(\d{2})(?::(\d{2}))?\s*(AM|PM)?)?$/i);
                if (namedMonth) {
                    var months = { jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5, jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11 };
                    var year = parseInt(namedMonth[3], 10);
                    if (year < 100) year += year < 50 ? 2000 : 1900;
                    var hour = parseInt(namedMonth[4] || "0", 10);
                    var minute = parseInt(namedMonth[5] || "0", 10);
                    var second = parseInt(namedMonth[6] || "0", 10);
                    if ((namedMonth[7] || "").toUpperCase() === "PM" && hour < 12) hour += 12;
                    if ((namedMonth[7] || "").toUpperCase() === "AM" && hour === 12) hour = 0;
                    if (months[namedMonth[2].toLowerCase()] !== undefined)
                        return new Date(year, months[namedMonth[2].toLowerCase()], parseInt(namedMonth[1], 10), hour, minute, second);
                }

                // Parse dd-MM-yyyy and dd/MM/yyyy explicitly.
                var numericDate = text.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{2}|\d{4})(?:\s+(\d{1,2}):(\d{2})(?::(\d{2}))?\s*(AM|PM)?)?$/i);
                if (numericDate) {
                    var y = parseInt(numericDate[3], 10);
                    if (y < 100) y += y < 50 ? 2000 : 1900;
                    var h = parseInt(numericDate[4] || "0", 10);
                    if ((numericDate[7] || "").toUpperCase() === "PM" && h < 12) h += 12;
                    if ((numericDate[7] || "").toUpperCase() === "AM" && h === 12) h = 0;
                    return new Date(y, parseInt(numericDate[2], 10) - 1, parseInt(numericDate[1], 10), h,
                        parseInt(numericDate[5] || "0", 10), parseInt(numericDate[6] || "0", 10));
                }
                var parsed = new Date(text);
                return isNaN(parsed.getTime()) ? null : parsed;
            }

            function parseProfileCurrency(value) {
                if (typeof value === "number") return value;
                if (value === null || value === undefined || String(value).trim() === "" || value === "—") return null;
                var cleaned = String(value).replace(/[₹$€£,\s]/g, "").replace(/^\((.*)\)$/, "-$1");
                var number = Number(cleaned);
                return isNaN(number) ? null : number;
            }

            function parseProfileBoolean(value) {
                if (typeof value === "boolean") return value;
                var normalized = String(value == null ? "" : value).trim().toLowerCase();
                if (normalized === "true" || normalized === "yes" || normalized === "1") return true;
                if (normalized === "false" || normalized === "no" || normalized === "0") return false;
                return null;
            }

            // Apply a per-column text alignment and remember it on the grid
            // so it remains in effect after sorting, filtering and paging.
            function applyProfileColumnAlignment(grid, field, alignment) {
                if (!grid || !field || !/^(left|center|right)$/.test(alignment)) return;

                var gridElement = grid.element;
                var alignments = gridElement.data("profileColumnAlignments") || {};
                alignments[field] = alignment;
                gridElement.data("profileColumnAlignments", alignments);

                var header = grid.thead.find("th[data-field]").filter(function () {
                    return $(this).attr("data-field") === field;
                }).first();

                if (!header.length) return;

                header.css("text-align", alignment);
                var visibleColumnIndex = grid.thead.find("th[data-field]").index(header);

                grid.tbody.children("tr").each(function () {
                    $(this).children("td").eq(visibleColumnIndex).css("text-align", alignment);
                });
            }

            function restoreProfileColumnAlignments(grid) {
                var alignments = grid.element.data("profileColumnAlignments") || {};
                Object.keys(alignments).forEach(function (field) {
                    applyProfileColumnAlignment(grid, field, alignments[field]);
                });
            }


        // All repeating profile grids use the shared attribute-driven initializer.
        // Each element carries its own data and metadata payload, so grids remain independent.
        if (!window.StaffSyncKendoGrid || typeof window.StaffSyncKendoGrid.initializeAll !== "function") {
            console.error("StaffSync generic Kendo Grid framework was not loaded.");
        } else {
            window.StaffSyncKendoGrid.initializeAll(".profile-records-grid");
        }


            // Skills and qualifications are rendered as escaped, read-only tags
            // by the Razor Tags() helper. No client-side widget initialization is needed.

            // Keep the first profile tab selected on initial load.
            if (tabStrip) {
                tabStrip.select(0);
                if (kendo && typeof kendo.resize === "function") {
                    kendo.resize($("#profileTabs"));
                }
            }

        })(window.jQuery, window.kendo);
