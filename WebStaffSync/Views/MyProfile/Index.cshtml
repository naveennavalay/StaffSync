<section class="profile-workspace">
    <div id="profileTabs">
        <ul>
            @foreach (var tab in tabs)
            {
                <li>@tab.Item2</li>
            }
        </ul>

        <div>
            <div class="profile-section-heading"><div><h2>Personal Information</h2><p>Your personal details and registered addresses</p></div></div>
            @Fields(Model.PersonalInfo)
            <div class="profile-subsection-grid">
                <div class="profile-subsection">
                    <h3>Current Address</h3>
                    @Fields(Model.ContactInfo.Where(x => x.Label.StartsWith("Current ", StringComparison.OrdinalIgnoreCase)).ToList())
                </div>
                <div class="profile-subsection">
                    <h3>Permanent Address</h3>
                    <p class="profile-muted">@(Model.SameAsCurrentAddress == "true" ? "Same as current address" : "")</p>
                    @Fields(Model.ContactInfo.Where(x => x.Label.StartsWith("Permanent ", StringComparison.OrdinalIgnoreCase)).ToList())
                </div>
            </div>
            <div class="profile-subsection">
                <h3>Contact Information</h3>
                @Fields(Model.ContactInfo.Where(x => !x.Label.StartsWith("Current ", StringComparison.OrdinalIgnoreCase) && !x.Label.StartsWith("Permanent ", StringComparison.OrdinalIgnoreCase)).ToList())
            </div>
        </div>

        <div>
            <div class="profile-section-heading"><div><h2>Professional Information</h2><p>Your employment and reporting details</p></div></div>
            @Fields(Model.ProfessionalInfo)
            <div class="profile-subsection-grid">
                <div class="profile-subsection"><h3>Contact Person</h3>@Fields(Model.ContactInfo.Where(x => x.Label.StartsWith("Contact Person", StringComparison.OrdinalIgnoreCase)).ToList())</div>
                <div class="profile-subsection"><h3>Nomination Details</h3>@Fields(Model.NominationInfo)</div>
            </div>
        </div>

        <div>
            <div class="profile-section-heading"><div><h2>Employee Photograph</h2><p>Photograph registered in your employee record</p></div></div>
            @if (!string.IsNullOrWhiteSpace(Model.PhotoDataUrl))
            {
                <div class="profile-photo-preview"><img src="@Model.PhotoDataUrl" alt="Employee photograph" /></div>
            }
            else
            {
                <div class="profile-empty">No employee photograph is available.</div>
            }
        </div>

        <div>
            <div class="profile-section-heading"><div><h2>Family Members</h2><p>Family information recorded in your employee profile</p></div></div>
            @Table(
                Model.FamilyMembers,
                new[]
                {
                    "Member Name",
                    "Date Of Birth",
                    "Age",
                    "Relationship",
                    "Address 01",
                    "Address 02",
                    "Area",
                    "City",
                    "State",
                    "PIN",
                    "Country",
                    "Contact Number",
                    "Mail ID",
                    "Blood Group",
                    "Is Insured?"
                },
                Model.FamilyMemberColumns)
        </div>

        <div>
            <div class="profile-section-heading"><div><h2>Previous Experience</h2><p>Your employment history</p></div></div>
