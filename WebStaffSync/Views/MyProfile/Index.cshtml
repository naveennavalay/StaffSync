                        timelineFallback.append(item);
                    });
                    $("#demoEmployeeTimeline").empty().append(timelineFallback);
                    console.warn("Kendo Timeline is not available in this bundle; sample timeline fallback is displayed.");
                }
            } catch (timelineError) {
                console.error("Timeline initialization failed:", timelineError);
            }

            // TreeView: organisation structure with nested department/employee nodes.
            var demoOrganizationData = [
                {
                    text: "StaffSync",
                    expanded: true,
                    items: [
                        {
                            text: "Information Technology",
                            expanded: true,
                            items: [
                                { text: "S. Kumar - Technical Specialist" },
                                { text: "A. Sharma - Software Engineer" }
                            ]
                        },
                        {
                            text: "Human Resources",
                            items: [
                                { text: "P. Reddy - HR Executive" }
                            ]
                        },
                        {
                            text: "Finance",
                            items: [
                                { text: "M. Patel - Accountant" }
                            ]
                        }
                    ]
                }
            ];

            try {
                if (typeof $.fn.kendoTreeView === "function") {
                    $("#demoOrganizationTree").kendoTreeView({
                        dataSource: demoOrganizationData,
                        dataTextField: "text"
                    });
                } else {
                    function renderDemoTree(nodes) {
                        var list = $("<ul/>");
                        nodes.forEach(function (node) {
                            var li = $("<li/>").text(node.text);
                            if (node.items && node.items.length) {
                                li.append(renderDemoTree(node.items));
                            }
                            list.append(li);
                        });
                        return list;
                    }
                    $("#demoOrganizationTree")
                        .addClass("profile-demo-tree-fallback")
                        .empty()
                        .append(renderDemoTree(demoOrganizationData));
                    console.warn("Kendo TreeView is not available in this bundle; nested tree fallback is displayed.");
                }
            } catch (treeViewError) {
                console.error("TreeView initialization failed:", treeViewError);
            }

            // TreeList: employee reporting hierarchy.
            var demoEmployeeHierarchy = [
                { id: 1, parentId: null, employeeCode: "EMP-0001", employeeName: "S. Kumar", designation: "Technical Specialist", department: "Information Technology" },
                { id: 2, parentId: 1, employeeCode: "EMP-0002", employeeName: "A. Sharma", designation: "Software Engineer", department: "Information Technology" },
                { id: 3, parentId: 1, employeeCode: "EMP-0003", employeeName: "P. Reddy", designation: "HR Executive", department: "Human Resources" },
                { id: 4, parentId: 1, employeeCode: "EMP-0004", employeeName: "M. Patel", designation: "Accountant", department: "Finance" },
